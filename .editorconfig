root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,twig}]
indent_style = space
indent_size = 4

[*.{js,json,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.xml]
indent_style = space
indent_size = 4

[composer.{json,lock}]
indent_style = space
indent_size = 4
